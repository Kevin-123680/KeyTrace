<Window x:Class="KeyTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KeyTrace.App.Views"
        xmlns:vm="clr-namespace:KeyTrace.App.ViewModels"
        mc:Ignorable="d"
        Title="键迹 KeyTrace"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardViewModel}">
            <views:KeyboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MouseViewModel}">
            <views:MouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeViewModel}">
            <views:TimeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="K" Foreground="#0F1117" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="键迹 KeyTrace" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="本地键鼠统计" Style="{StaticResource MutedStyle}" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Style="{StaticResource NavListBox}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage, Mode=TwoWay}" />

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Border Style="{StaticResource InsetCardStyle}" Padding="12,10">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" />
                            </DockPanel>
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedStyle}" FontSize="10.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Button Content="暂停 / 继续" Style="{StaticResource SubtleButton}" Margin="0,10,0,0"
                                    Command="{Binding TogglePauseCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding FooterText}" Style="{StaticResource MutedStyle}" FontSize="9.5"
                               TextWrapping="Wrap" Margin="4,10,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />
            <Border Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="14,10"
                    Margin="28,0,28,20" VerticalAlignment="Bottom"
                    Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LoadError}" Foreground="#1A0F0F" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
