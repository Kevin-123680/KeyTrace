<UserControl x:Class="KeyTrace.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:KeyTrace.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="680">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- 标题 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource InsetCardStyle}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="实时" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WpmText}" FontFamily="{StaticResource NumberFontFamily}" FontSize="18"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="WPM" Style="{StaticResource MutedStyle}" Margin="4,0,0,2" VerticalAlignment="Bottom" />
                        <TextBlock Text="·" Style="{StaticResource MutedStyle}" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="峰值" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PeakWpmText}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 四个大数字 -->
            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                            <StackPanel>
                                <Grid Width="34" Height="34" HorizontalAlignment="Left">
                                    <Border Background="{Binding Accent}" CornerRadius="10" Opacity="0.16" />
                                    <TextBlock Text="{Binding Glyph}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource LabelStyle}" Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatValueStyle}" TextTrimming="None" />
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource StatUnitStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedStyle}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 24 小时趋势 + 目标 / 累计 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="今日 24 小时分布" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding HourlySummary}" Style="{StaticResource MutedStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <controls:BarChart Grid.Row="1" Margin="0,12,0,0"
                                           Values="{Binding HourlySeries}"
                                           Labels="{Binding HourlyLabels}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="每日小目标" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding GoalText}" FontFamily="{StaticResource NumberFontFamily}"
                                       FontSize="22" Margin="0,10,0,0" />
                            <ProgressBar Style="{StaticResource BarProgress}" Maximum="100"
                                         Value="{Binding GoalProgress, Mode=OneWay}" Margin="0,12,0,0" />
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="完成度" Style="{StaticResource MutedStyle}" />
                                <TextBlock Text="{Binding GoalPercentText}" Style="{StaticResource MutedStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="累计" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="总按键" Style="{StaticResource MutedStyle}" />
                                    <TextBlock Text="{Binding TotalKeysText}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="活跃天数" Style="{StaticResource MutedStyle}" />
                                    <TextBlock Text="{Binding ActiveDaysText}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Text="连续使用" Style="{StaticResource MutedStyle}" />
                                    <TextBlock Text="{Binding StreakText}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <TextBlock Text="鼠标里程" Style="{StaticResource MutedStyle}" />
                                    <TextBlock Text="{Binding TotalDistanceText}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BooksText}" Style="{StaticResource MutedStyle}"
                                       TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 本周对比 + 成就 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="本周 vs 上周" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding WeekRangeText}" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />

                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="指标" Style="{StaticResource MutedStyle}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="本周" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="上周" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="变化" Style="{StaticResource MutedStyle}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WeekMetrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="66" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding ThisWeek}" FontSize="12.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastWeek}" FontSize="12.5"
                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding DeltaText}" FontSize="12.5"
                                                   Foreground="{Binding DeltaBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding WeekHeadline}" Style="{StaticResource MutedStyle}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="成就徽章" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding UnlockedSummary}" Style="{StaticResource MutedStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Achievements}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{Binding Border}"
                                            BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,8,8"
                                            Width="146" ToolTip="{Binding Tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}"
                                                           FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{Binding Foreground}"
                                                           Opacity="0.62" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
