<UserControl x:Class="KeyTrace.App.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource InsetCardStyle}" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="今日按键" Style="{StaticResource MutedStyle}" FontSize="11" />
                            <TextBlock Text="{Binding TodayKeysText}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCardStyle}" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="用到键位" Style="{StaticResource MutedStyle}" FontSize="11" />
                            <TextBlock Text="{Binding UniqueKeysText}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCardStyle}" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="覆盖率" Style="{StaticResource MutedStyle}" FontSize="11" />
                            <TextBlock Text="{Binding CoverageText}" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCardStyle}" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="实时 WPM" Style="{StaticResource MutedStyle}" FontSize="11" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding WpmText}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PeakWpmText, StringFormat='峰值 {0}'}" Style="{StaticResource MutedStyle}"
                                           FontSize="10" Margin="6,0,0,3" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 键盘热图 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="QWERTY 键盘热图" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="颜色越亮 = 按得越多 · 只记录 VK 码" Style="{StaticResource MutedStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,16,0,0" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding KeyRows}" Width="690">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Keys}" Margin="0,0,0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="44" Margin="0,0,5,0"
                                                        CornerRadius="6" Background="{Binding Background}"
                                                        BorderBrush="{Binding Border}" BorderThickness="1"
                                                        ToolTip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5"
                                                               Foreground="{Binding Foreground}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>

                    <TextBlock Text="还没有今天的按键数据，随便敲几下键盘就会出现在这里。"
                               Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Top 10 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Top 10 高频按键" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding TopKeyText, StringFormat='最高：{0}'}" Style="{StaticResource MutedStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopKeys}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource MutedStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="2" Style="{StaticResource BarProgress}"
                                                     Maximum="1" Value="{Binding Ratio, Mode=OneWay}" VerticalAlignment="Center"
                                                     Margin="6,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource MutedStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="今天还没有按键记录">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 快捷键 -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="常用快捷键（近 7 天）" Style="{StaticResource SectionTitleStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopCombos}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource MutedStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="2" Style="{StaticResource BarProgress}"
                                                     Maximum="1" Value="{Binding Ratio, Mode=OneWay}" VerticalAlignment="Center"
                                                     Margin="6,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource MutedStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有统计到 Ctrl / Alt / Win 组合键">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCombos}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
