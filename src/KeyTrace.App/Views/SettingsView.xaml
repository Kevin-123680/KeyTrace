<UserControl x:Class="KeyTrace.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Margin="0,0,16,0">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="采集" Style="{StaticResource SectionTitleStyle}" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                      IsChecked="{Binding IsPaused}" Content="暂停采集（暂停期间不产生任何计数）" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding StartWithWindows}" Content="开机自动启动（当前用户）" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding MinimizeToTray}" Content="关闭窗口时最小化到托盘" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding TrackShortcutCombos}" Content="统计快捷键组合（Ctrl+C 等）" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding IgnoreInjectedInput}" Content="忽略程序合成的输入" />

                            <TextBlock Text="自动化脚本通过 SendInput 产生的输入默认也会被记录；开启后只统计真实设备输入。"
                                       Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="每日按键小目标（0 = 关闭）" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding DailyKeyGoal, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,6,0,0" Width="140" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="落盘间隔（秒）" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right" />
                                    <TextBox Text="{Binding FlushIntervalSeconds, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,6,0,0" Width="100" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="隐私静默" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="命中下面任意一条时，整段时间完全停止计数。判定只读取前台进程名与窗口标题，不会保存它们。"
                                       Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                      IsChecked="{Binding PrivacyFilterEnabled}" Content="敏感窗口自动静默" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding CaptureClickZones}" Content="记录点击热区（按 20 × 10 网格归一化）" />

                            <TextBlock Text="静默进程名（不含 .exe）" Style="{StaticResource LabelStyle}" Margin="0,18,0,0" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="添加" Style="{StaticResource SubtleButton}"
                                        Command="{Binding AddProcessCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding NewProcessText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding BlockedProcesses}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7"
                                                Padding="10,5" Margin="0,0,0,5">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource LinkButton}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="静默标题关键词" Style="{StaticResource LabelStyle}" Margin="0,14,0,0" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="添加" Style="{StaticResource SubtleButton}"
                                        Command="{Binding AddTitleCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding NewTitleText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding BlockedTitles}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7"
                                                Padding="10,5" Margin="0,0,0,5">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource LinkButton}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveTitleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- 右列 -->
                <StackPanel Grid.Column="1">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="DPI 校准" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="鼠标 DPI 不同，同样的物理位移会报出不同的像素数。拿着鼠标划过 10 厘米，软件反推换算系数。"
                                       Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding MetersPerPixelText}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DpiText}" Style="{StaticResource MutedStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="校准样本" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" FontSize="11" />
                                    <TextBlock Text="{Binding CalibrationPixelsText}" FontSize="12.5" HorizontalAlignment="Right"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CalibrationHint}" Style="{StaticResource MutedStyle}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="开始校准" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding StartCalibrationCommand}" Margin="0,0,8,8" />
                                <Button Content="完成校准" Style="{StaticResource GhostButton}"
                                        Command="{Binding CompleteCalibrationCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="取消" Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelCalibrationCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="恢复默认" Style="{StaticResource LinkButton}"
                                        Command="{Binding ResetCalibrationCommand}" Margin="0,0,0,8" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DatabaseInfoText}" Style="{StaticResource MutedStyle}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding DataPathText}" Style="{StaticResource MutedStyle}" FontSize="10.5"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="导出 CSV" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ExportDataCommand}" Margin="0,0,8,8" />
                                <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                                <Button Content="清空所有数据" Style="{StaticResource DangerButton}"
                                        Command="{Binding ClearDataCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" />
                            <TextBlock Text="只记录按键码与鼠标距离，不记录任何输入内容；数据只写在本机 %AppData%\KeyTrace，不联网、不上传。"
                                       Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" />
                            <Button Content="打开 GitHub 仓库" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenRepositoryCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
